{
  "name": "@mengxing123456789/pelican-test",
  "version": "2.2.2",
  "description": "The Pelican Test — a procedurally generated film: a pelican chases a drawing through 24 eras of art, every frame drawn and scored by code",
  "keywords": [
    "procedural-art",
    "p5js",
    "p5-brush",
    "creative-coding",
    "generative-art",
    "animation",
    "web-audio",
    "computer-graphics",
    "film"
  ],
  "homepage": "https://github.com/mengxing123456789/pelican-test#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengxing123456789/pelican-test.git"
  },
  "bugs": {
    "url": "https://github.com/mengxing123456789/pelican-test/issues"
  },
  "author": "Royce Bella (original) · SP_Z (v2 changes)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/server.mjs",
    "shot": "node tools/shot.mjs",
    "sheet": "node tools/sheet.mjs",
    "render": "node tools/render.mjs",
    "audio": "node tools/audio.mjs",
    "levels": "node tools/levels.mjs",
    "encode": "node tools/encode.mjs",
    "cover": "node tools/cover.mjs",
    "check": "node tools/check.mjs",
    "check:frames": "node tools/check-frames.mjs",
    "check:sync": "node tools/check-sync.mjs",
    "render:segmented": "node tools/render-segmented.mjs",
    "preview": "node tools/preview-strip.mjs",
    "build": "node tools/audio.mjs && node tools/render-segmented.mjs",
    "publish:api": "node tools/push-via-api.mjs"
  },
  "dependencies": {
    "p5": "2.3.4",
    "p5.brush": "2.2.3",
    "puppeteer-core": "25.14.0"
  },
  "files": [
    "src",
    "audio/*.js",
    "audio/levels.json",
    "tools",
    "briefs",
    "docs",
    "film.html",
    "index.html",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "PROVENANCE.md"
  ]
}
